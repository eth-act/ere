ARG BASE_IMAGE=ere-base:latest

# ZisK requires Ubuntu 22.04 or higher (ere-base uses 24.04 by default).
FROM $BASE_IMAGE

# Whether to enable CUDA feature or not.
ARG CUDA

# Install the ZisK system dependencies that the build uses, a subset of
# https://0xpolygonhermez.github.io/zisk/getting_started/installation.html
RUN apt-get update && apt-get install -y --no-install-recommends \
    xz-utils \
    libomp-dev \
    libgmp-dev \
    nlohmann-json3-dev \
    libsodium-dev \
    nasm \
    libopenmpi-dev \
    openmpi-bin \
    openmpi-common \
    libclang-dev \
    # libprotobuf-dev provides the well-known proto files.
    libprotobuf-dev \
    gcc-riscv64-unknown-elf \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Set default toolchain for ZisK.
RUN rustup toolchain install --profile minimal --component clippy,rustfmt 1.96.0 \
    && rustup default 1.96.0

# Add nightly toolchain to provide cargo fallback for zisk toolchain
RUN rustup toolchain install --profile minimal nightly

# Copy the ZisK SDK installer script from the workspace context
COPY --chmod=755 scripts/sdk_installers/install_zisk_sdk.sh /tmp/install_zisk_sdk.sh

# Run the ZisK SDK installation script using ziskup.
# This script installs the 'zisk' Rust toolchain and `cargo-zisk`
RUN /tmp/install_zisk_sdk.sh && rm /tmp/install_zisk_sdk.sh

# Add ZisK SDK to path
ENV PATH=/root/.zisk/bin:$PATH

# Build the ASM services from the SDK, which has the patched `main.c`, not from the cargo checkout of the ZisK crates.
ENV ZISK_USE_INSTALLED=1

# Verify the ZisK SDK installation.
RUN cargo-zisk --version
