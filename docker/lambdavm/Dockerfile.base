ARG BASE_IMAGE=ere-base:latest

FROM $BASE_IMAGE

# The ere-base image provides Rust, Cargo, and common tools.
# We operate as root for SDK installation.

# Set default toolchain to the one LambdaVM pins, according to
# https://github.com/yetanotherco/lambda_vm/blob/v0.1.0/rust-toolchain.toml
RUN rustup default 1.94.0 && \
    rustup toolchain list | grep -v default | xargs -r rustup toolchain uninstall

# Add nightly toolchain to provide cargo fallback for stock compilation
RUN rustup toolchain install --profile minimal nightly

# Copy the LambdaVM SDK installer script from the workspace context
COPY --chmod=755 scripts/sdk_installers/install_lambdavm_sdk.sh /tmp/install_lambdavm_sdk.sh

# Run the LambdaVM SDK installation script.
# This script installs the Rust toolchain LambdaVM builds guest programs with.
RUN /tmp/install_lambdavm_sdk.sh && rm /tmp/install_lambdavm_sdk.sh

CMD ["/bin/bash"]
