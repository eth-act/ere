ARG BASE_IMAGE=ere-base:latest

FROM $BASE_IMAGE

# Whether to enable CUDA feature or not.
ARG CUDA

# libprotobuf-dev provides the well-known proto files.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libprotobuf-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Set default toolchain for SP1.
RUN rustup toolchain install --profile minimal --component clippy,rustfmt 1.91.1 \
    && rustup default 1.91.1

# Copy the SP1 SDK installer script
COPY --chmod=755 scripts/sdk_installers/install_sp1_sdk.sh /tmp/install_sp1_sdk.sh

# Define where the SP1 SDK goes within the image.
# The install_sp1_sdk.sh script reads these ENV variables.
ENV SP1_DIR=/root/.sp1 \
    SP1_VERSION=v6.10.0

# Run the SP1 SDK installation script with secret mount
# It uses the SP1_DIR and SP1_VERSION defined above.
RUN --mount=type=secret,id=github_token \
    if [ -s /run/secrets/github_token ]; then \
        export GITHUB_TOKEN="$(cat /run/secrets/github_token)"; \
    fi \
    && /tmp/install_sp1_sdk.sh && rm /tmp/install_sp1_sdk.sh

# Add SP1 SDK to path
ENV PATH=${SP1_DIR}/bin:$PATH

# Verify the SP1 SDK installation.
RUN cargo prove --version
