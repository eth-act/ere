ARG BASE_ZKVM_IMAGE=ere-base-openvm:latest
ARG RUNTIME_IMAGE=ubuntu:24.04
ARG RUNTIME_CUDA_IMAGE=nvidia/cuda:12.9.1-runtime-ubuntu24.04

# Whether to enable CUDA feature or not.
ARG CUDA

FROM $BASE_ZKVM_IMAGE AS build_stage

COPY . /ere

WORKDIR /ere

ARG CUDA
ARG RUSTFLAGS

# Env variable read by OpenVM crate `openvm-cuda-builder`, comma-separated numeric arch IDs (e.g. "120" or "89,120")
ARG CUDA_ARCH=120

RUN cargo build --release --package ere-server --bin ere-server --features openvm${CUDA:+,cuda} \
    && mkdir bin && mv target/release/ere-server bin/ere-server \
    && cargo clean && rm -rf $CARGO_HOME/registry/

FROM $RUNTIME_IMAGE AS runtime
FROM $RUNTIME_CUDA_IMAGE AS runtime_cuda
FROM runtime${CUDA:+_cuda} AS runtime_stage

# `rvr` compiles guest programs with clang and lld. Ubuntu 24.04 ships
# clang-18 while rvr requires 19 or newer, so clang-22, rvr's own default,
# comes from apt.llvm.org.
RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils \
    ca-certificates \
    gcc \
    gnupg \
    libc6-dev \
    lsb-release \
    make \
    software-properties-common \
    wget \
    && wget -qO /tmp/llvm.sh https://apt.llvm.org/llvm.sh \
    && chmod +x /tmp/llvm.sh \
    && /tmp/llvm.sh 22 \
    && apt-get install -y --no-install-recommends lld-22 \
    && rm -f /tmp/llvm.sh \
    # rvr probes for a bare `lld`/`ld.lld`, and clang's `-fuse-ld=` only accepts
    # `lld` or an absolute path, so the versioned packages need plain aliases.
    && ln -sf /usr/bin/lld-22 /usr/bin/lld \
    && ln -sf /usr/bin/ld.lld-22 /usr/bin/ld.lld \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# `OPENVM_RVR_NATIVE_CACHE_DIR` lets rvr reuse a compiled guest artifact across
# proofs instead of rebuilding it on every call.
ENV RVR_CC=clang-22 \
    RVR_LD=lld \
    OPENVM_RVR_NATIVE_CACHE_DIR=/root/.openvm/cache

# Copy OpenVM internal-recursive proving key loaded by the prover at runtime.
COPY --from=build_stage /root/.openvm/internal_recursive.pk /root/.openvm/internal_recursive.pk

# Copy ere-server
COPY --from=build_stage /ere/bin/ere-server /ere/bin/ere-server

ENTRYPOINT ["/ere/bin/ere-server"]
